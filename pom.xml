<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org" 
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hydratation</groupId>
    <artifactId>beber</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Version stable du moteur Codename One -->
        <dependency>
            <groupId>com.codenameone</groupId>
            <artifactId>codenameone-core</artifactId>
            <version>7.0.264</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilateur Java standard -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                </configuration>
            </plugin>

            <!-- Créateur de fichier JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>beber</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Liaison automatique de l'envoi iOS -->
            <plugin>
                <groupId>com.codenameone</groupId>
                <artifactId>codenameone-maven-plugin</artifactId>
                <version>7.0.264</version>
                <executions>
                    <execution>
                        <id>envoi-ios</id>
                        <phase>package</phase>
                        <goals>
                            <goal>build</goal>
                        </goals>
                        <configuration>
                            <platform>ios</platform>
                            <buildTarget>ios-source</buildTarget>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <platform>ios</platform>
                    <buildTarget>ios-source</buildTarget>
                </configuration>
            </plugin>     
       </plugins>
    </build>
</project>
